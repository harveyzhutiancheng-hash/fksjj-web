[Unit]
Description=Snapshot Ocean Drifters database
After=fkssj-api.service

[Service]
Type=oneshot
User=fkssj
Group=fkssj
ExecStart=/usr/bin/python3 /srv/fkssj/api-current/deploy/fkssj-backup.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/fkssj /var/backups/fkssj
